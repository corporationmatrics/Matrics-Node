                <item android:offset="0.35" android:color="#ECEFF1" />
                <item android:offset="0.70" android:color="#78909C" />
                <item android:offset="1.0" android:color="#1A242B" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Sharp mirror rim specular -->
    <path
        android:pathData="M256,250 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.95" />

