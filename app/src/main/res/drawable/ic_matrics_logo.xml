    <path
        android:pathData="M256,250 L334,250 L256,320 Z"
        android:fillAlpha="0.50">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="256"
                android:startY="250"
                android:endX="334"
                android:endY="320"
                android:type="linear">
                <item android:offset="0.0" android:color="#D84315" />
                <item android:offset="1.0" android:color="#5D1000" />
