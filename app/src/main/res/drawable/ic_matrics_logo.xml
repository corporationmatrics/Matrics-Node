            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Pillar Top Angled Bevel / Chamfer (Cyan Specular Reflection) -->
    <path
        android:pathData="M120,200 L186,140 L256,200 L186,250 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="120"
                android:startY="140"
                android:endX="256"
                android:endY="250"
                android:type="linear">
