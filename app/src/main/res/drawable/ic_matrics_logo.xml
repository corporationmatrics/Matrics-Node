    <path
        android:pathData="M256,250 L256,320 L178,250 Z"
        android:fillAlpha="0.35">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="178"
                android:startY="250"
                android:endX="256"
                android:endY="320"
                android:type="linear">
